#!/bin/sh
set -eu

[ "$#" = 2 ] || { echo "Usage: $0 ACTION SERVICE" >&2; exit 2; }
[ "$2" = gofro-relay ] || { echo "Unknown service: $2" >&2; exit 2; }

case "$1" in
	start|stop|restart) exec systemctl "$1" gofro-relay.service ;;
	status) exec systemctl is-active --quiet gofro-relay.service ;;
	*) echo "Unknown action: $1" >&2; exit 2 ;;
esac
