#!/bin/sh
set -eu

CONNECTION=gofro-ap
ONBOARDING=${GOFRO_ONBOARDING_COMMAND:-/usr/libexec/gofro/onboarding}

usage() {
	echo "Usage: $0 list | set BAND SSID (password on stdin; empty retains)" >&2
	exit 2
}

case "${1:-}" in
	list)
		[ "$#" = 1 ] || usage
		ssid="$(nmcli --terse --escape no --get-values 802-11-wireless.ssid connection show "$CONNECTION")"
		[ -n "$ssid" ] || { echo 'Gofro access point has no SSID' >&2; exit 1; }
		printf '5g\t%s\n' "$ssid"
		;;
	set)
		[ "$#" = 3 ] || usage
		case "$2" in 5g|all) ;; *) usage ;; esac
		IFS= read -r password || password=
		printf '%s\n' "$password" | "$ONBOARDING" set 5g "$3"
		(sleep 2; nmcli connection down "$CONNECTION"; nmcli connection up "$CONNECTION") >/dev/null 2>&1 &
		;;
	*) usage ;;
esac
