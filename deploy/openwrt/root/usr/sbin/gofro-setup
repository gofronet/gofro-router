#!/bin/sh
set -eu

die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die 'run as root'
[ "$#" -le 1 ] || die 'usage: gofro-setup [COUNTRY]'
if [ "$#" = 1 ]; then case "$1" in [A-Z][A-Z]) ;; *) die 'country must be a two-letter uppercase code' ;; esac; fi
lock=/tmp/gofro-setup.lock
mkdir "$lock" 2>/dev/null || die 'another setup is running'
trap 'rmdir "$lock"' EXIT
trap 'exit 1' HUP INT TERM

state_dir=/etc/gofro; marker=$state_dir/openwrt-owned-v16; state=$state_dir/onboarding-state; window=$state_dir/onboarding-window
[ ! -e "$state_dir/routing-legacy.json" ] || die 'fresh setup cannot adopt legacy routing history'
interface="$(uci -q get gofro.main.interface || printf '%s' gt0)"
[ "$interface" = gt0 ] || die 'Gofro only owns the gt0 interface'
[ ! -e "$marker" ] || [ "$(cat "$marker")" = "$interface" ] || die 'invalid Gofro ownership marker'
[ ! -e "$state_dir/admin-password" ] || die 'an administrator is already configured'
[ ! -e "$state" ] || [ "$(cat "$state")" = admin ] || die 'finish legacy onboarding manually before setup'
uci -q get network.gofro_setup >/dev/null && die 'finish legacy setup manually in OpenWrt before continuing'
[ ! -d /sys/class/net/br-gofro-setup ] || die 'finish legacy setup manually in OpenWrt before continuing'

# Do every collision check before generating a key or editing UCI.
/usr/libexec/gofro/transaction panel-check || die 'panel DNS ownership validation failed'
for name in gofro_vpn gofro_lan_vpn gofro_lan_http gofro_lan_https gofro_lan_dns; do
	if uci -q get "firewall.$name" >/dev/null && [ ! -s "$marker" ]; then die "firewall.$name already exists"; fi
done
if uci -q get "network.$interface" >/dev/null && [ ! -s "$marker" ]; then die "network.$interface already exists"; fi
[ ! -e /etc/wireguard/client.key ] || [ -s "$marker" ] || die 'existing WireGuard key has no Gofro ownership marker'
[ ! -e /etc/wireguard/client.pub ] || [ -s "$marker" ] || die 'existing WireGuard public key has no Gofro ownership marker'
[ ! -e "$state_dir/guard-device" ] || [ -s "$marker" ] || die 'existing boot guard has no Gofro setup ownership marker'

rollback() {
	status=$?; trap - EXIT HUP INT TERM; set +e
	# Keep ownership, keys and the enabled boot guard so retry can finish partial writes.
	if [ "$status" != 0 ]; then
		[ -s "$state_dir/guard-device" ] || echo 'warning: boot guard is not persisted; retry setup before relying on reboot protection' >&2
		/etc/init.d/gofro-agent stop
		/etc/init.d/gofro-relay stop
	fi
	rmdir "$lock"
	exit "$status"
}
trap rollback EXIT
trap 'exit 1' HUP INT TERM

mkdir -p "$state_dir" /etc/wireguard; chmod 700 "$state_dir"; umask 077
printf '%s\n' "$interface" > "$marker.new"; mv -f "$marker.new" "$marker"; sync
/etc/init.d/gofro-guard enable
snapshot="$(/usr/libexec/gofro/guard prepare)"
device="$(printf '%s' "$snapshot" | jsonfilter -e '@.device')"; subnet="$(printf '%s' "$snapshot" | jsonfilter -e '@.subnet')"
/usr/libexec/gofro/mode check "$device" "$subnet"
address="$(printf '%s' "$snapshot" | jsonfilter -e '@.address')"; zone="$(printf '%s' "$snapshot" | jsonfilter -e '@.zone')"
if [ ! -s /etc/wireguard/client.key ]; then
	wg genkey > /etc/wireguard/client.key.new; mv -f /etc/wireguard/client.key.new /etc/wireguard/client.key
fi
wg pubkey < /etc/wireguard/client.key > /etc/wireguard/client.pub.new; mv -f /etc/wireguard/client.pub.new /etc/wireguard/client.pub
uci set "network.$interface=interface"; uci set "network.$interface.proto=wireguard"; uci set "network.$interface.private_key=$(cat /etc/wireguard/client.key)"
if uci -q get "network.$interface.addresses" >/dev/null; then uci delete "network.$interface.addresses"; fi
uci add_list "network.$interface.addresses=10.202.0.2/32"; uci set "network.$interface.listen_port=51821"; uci set "network.$interface.mtu=1280"; uci set "network.$interface.auto=0"; uci commit network
uci set firewall.gofro_vpn='zone'; uci set firewall.gofro_vpn.name='gofro_vpn'
if uci -q get firewall.gofro_vpn.network >/dev/null; then uci delete firewall.gofro_vpn.network; fi
uci add_list firewall.gofro_vpn.network="$interface"
uci set firewall.gofro_vpn.input=REJECT; uci set firewall.gofro_vpn.output=ACCEPT; uci set firewall.gofro_vpn.forward=REJECT; uci set firewall.gofro_vpn.mtu_fix=1; uci set firewall.gofro_vpn.masq=1
uci set firewall.gofro_lan_vpn='forwarding'; uci set firewall.gofro_lan_vpn.src="$zone"; uci set firewall.gofro_lan_vpn.dest=gofro_vpn
for rule in http https dns; do case "$rule" in http) proto=tcp; port=8081 ;; https) proto=tcp; port=8443 ;; dns) proto='tcp udp'; port=5353 ;; esac; uci set "firewall.gofro_lan_$rule=rule"; uci set "firewall.gofro_lan_$rule.src=$zone"; uci set "firewall.gofro_lan_$rule.proto=$proto"; uci set "firewall.gofro_lan_$rule.dest_port=$port"; uci set "firewall.gofro_lan_$rule.target=ACCEPT"; done
uci commit firewall
/usr/libexec/gofro/transaction panel-apply

if [ ! -s "$state_dir/setup-code" ]; then
	openssl rand -hex 16 > "$state_dir/setup-code.new"; chmod 600 "$state_dir/setup-code.new"; mv -f "$state_dir/setup-code.new" "$state_dir/setup-code"
fi
boot="$(cat /proc/sys/kernel/random/boot_id)"; read -r now _ < /proc/uptime; now=${now%%.*}; printf '%s %s\n' "$boot" "$((now + 900))" > "$window.new"; chmod 600 "$window.new"; mv -f "$window.new" "$window"
printf '%s\n' admin > "$state.new"; chmod 600 "$state.new"; mv -f "$state.new" "$state"; sync

/usr/bin/gofro-agent --https-listen "$address:8443" --init-security >/dev/null
if [ -n "${GOFRO_INSTALL_VERSION:-}" ]; then
	printf '%s\n' "$GOFRO_INSTALL_VERSION" > "$state_dir/install-pending.new"; chmod 600 "$state_dir/install-pending.new"; mv -f "$state_dir/install-pending.new" "$state_dir/install-pending"
fi
/etc/init.d/firewall reload; /etc/init.d/gofro-relay enable; /etc/init.d/gofro-agent enable; /etc/init.d/gofro-agent restart
if [ -n "${GOFRO_INSTALL_VERSION:-}" ]; then
	/etc/init.d/gofro-finalize boot || die 'Gofro did not become healthy'
fi
rmdir "$lock"
trap - EXIT HUP INT TERM
printf 'Gofro setup URL: https://%s:8443\nSetup code: %s\n' "$address" "$(cat "$state_dir/setup-code")"
