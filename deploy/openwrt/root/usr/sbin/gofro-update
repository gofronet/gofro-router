#!/bin/sh
set -eu

ARCHIVE=
MANIFEST=
TARGET=
DEFAULT_BASE_URL=https://github.com/gofronet/gofro-router/releases/latest/download
BASE_URL=${GOFRO_RELEASE_URL:-$DEFAULT_BASE_URL}
GITHUB_ASSETS_CIDR=185.199.108.0/22
KEY=/etc/gofro/update-public.pem
LOCK=/tmp/gofro-update.lock
LOCKED=
TMP=
ASSET_ROUTE=

die() {
	echo "error: $*" >&2
	exit 1
}

cleanup() {
	[ -z "$ASSET_ROUTE" ] || ip route del "$GITHUB_ASSETS_CIDR" dev "$ASSET_ROUTE" 2>/dev/null || true
	[ -z "$TMP" ] || rm -rf "$TMP"
	[ -z "$LOCKED" ] || rmdir "$LOCK" 2>/dev/null || true
}
trap cleanup EXIT

valid_version() {
	case "$1" in ''|*[!0-9.]*) return 1 ;; esac
	old_ifs=$IFS
	IFS=.
	# shellcheck disable=SC2086
	set -- $1
	IFS=$old_ifs
	[ "$#" = 3 ] && [ -n "$1" ] && [ -n "$2" ] && [ -n "$3" ]
}

version_newer() {
	new=$1
	old=$2
	old_ifs=$IFS
	IFS=.
	# shellcheck disable=SC2086
	set -- $new
	new_major=$1 new_minor=$2 new_patch=$3
	# shellcheck disable=SC2086
	set -- $old
	old_major=$1 old_minor=$2 old_patch=$3
	IFS=$old_ifs

	[ "$new_major" -gt "$old_major" ] && return 0
	[ "$new_major" = "$old_major" ] || return 1
	[ "$new_minor" -gt "$old_minor" ] && return 0
	[ "$new_minor" = "$old_minor" ] || return 1
	[ "$new_patch" -gt "$old_patch" ]
}

write_public_key() {
	cat > "$1" <<'EOF'
-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEA49UWlsfVa3Coq+iY4WJSf5UPQEwC6nalT/CeOy+gdvk=
-----END PUBLIC KEY-----
EOF
}

route_release_assets() {
	[ "$mode" = update ] || return 0
	[ "$BASE_URL" = "$DEFAULT_BASE_URL" ] || return 0
	interface="$(uci -q get gofro.main.interface || echo gt0)"
	ip link show "$interface" >/dev/null 2>&1 || return 0
	# ponytail: The ISP blocks GitHub's current assets CIDR; update this if GitHub moves it.
	if ip route add "$GITHUB_ASSETS_CIDR" dev "$interface" 2>/dev/null; then
		ASSET_ROUTE=$interface
	fi
}

platform_for() {
	case "$1:$2" in
		mediatek/filogic:cudy,tr3000-256mb-v1) echo aarch64-openwrt-linux-musl ;;
		*) return 1 ;;
	esac
}

detect_platform() {
	[ -r /etc/openwrt_release ] || die 'OpenWrt is required'
	# shellcheck disable=SC1091
	. /etc/openwrt_release
	case "${DISTRIB_RELEASE:-}" in 25.12.*) ;; *) die 'OpenWrt 25.12 is required' ;; esac
	IFS= read -r board < /tmp/sysinfo/board_name || die 'router model is unavailable'
	TARGET="$(platform_for "${DISTRIB_TARGET:-}" "$board")" || die "unsupported router: $board"
	ARCHIVE="gofro-router-$TARGET.tar.gz"
	case "$TARGET" in
		aarch64-openwrt-linux-musl) MANIFEST=gofro-router-manifest.json ;;
		*) MANIFEST="gofro-router-manifest-$TARGET.json" ;;
	esac
}

[ "$(id -u)" = 0 ] || die 'run as root'
case "${1:-}" in
	'') mode=update ;;
	--install)
		[ "$#" = 2 ] || die 'usage: gofro-update [--install COUNTRY]'
		case "$2" in [A-Z][A-Z]) country=$2 ;; *) die 'country must be a two-letter uppercase code' ;; esac
		mode=install
		;;
	*) die 'usage: gofro-update [--install COUNTRY]' ;;
esac

detect_platform

if [ "$mode" = install ]; then
	[ ! -e /etc/gofro/version ] || die 'Gofro is already installed'
else
	[ -s "$KEY" ] || die 'update public key is missing'
fi

mkdir "$LOCK" 2>/dev/null || die 'another update is running'
LOCKED=1
TMP="$(mktemp -d)"
BASE_URL=${BASE_URL%/}

if [ "$mode" = install ]; then
	apk update
	apk add ca-bundle jsonfilter openssl-util uclient-fetch
	KEY=$TMP/update-public.pem
	write_public_key "$KEY"
fi
route_release_assets

uclient-fetch -q -T 60 -O "$TMP/$MANIFEST" "$BASE_URL/$MANIFEST"
uclient-fetch -q -T 60 -O "$TMP/$MANIFEST.sig" "$BASE_URL/$MANIFEST.sig"
openssl pkeyutl -verify -pubin -inkey "$KEY" -rawin \
	-in "$TMP/$MANIFEST" -sigfile "$TMP/$MANIFEST.sig" >/dev/null \
	|| die 'release signature is invalid'

schema="$(jsonfilter -i "$TMP/$MANIFEST" -e '@.schema')"
version="$(jsonfilter -i "$TMP/$MANIFEST" -e '@.version')"
target="$(jsonfilter -i "$TMP/$MANIFEST" -e '@.target')"
archive="$(jsonfilter -i "$TMP/$MANIFEST" -e '@.archive')"
sha256="$(jsonfilter -i "$TMP/$MANIFEST" -e '@.sha256')"
[ "$schema" = 1 ] || die 'release schema is invalid'
valid_version "$version" || die 'release version is invalid'
[ "$target" = "$TARGET" ] || die 'release target is invalid'
[ "$archive" = "$ARCHIVE" ] || die 'release archive is invalid'
case "$sha256" in ''|*[!0-9a-f]*) die 'release checksum is invalid' ;; esac
[ "${#sha256}" = 64 ] || die 'release checksum is invalid'
if [ "$mode" = update ]; then
	IFS= read -r installed < /etc/gofro/version || die 'installed version is missing'
	valid_version "$installed" || die 'installed version is invalid'
	if [ "$version" = "$installed" ]; then
		echo "Gofro $installed is up to date"
		exit 0
	fi
	version_newer "$version" "$installed" || die "Gofro $version is older than $installed"
fi

asset_url=$BASE_URL
[ "$BASE_URL" != "$DEFAULT_BASE_URL" ] || asset_url="https://github.com/gofronet/gofro-router/releases/download/v$version"
uclient-fetch -q -T 300 -O "$TMP/$ARCHIVE" "$asset_url/$ARCHIVE"
printf '%s  %s\n' "$sha256" "$TMP/$ARCHIVE" | sha256sum -c - >/dev/null \
	|| die 'release checksum does not match'

mkdir "$TMP/bundle"
tar -xzf "$TMP/$ARCHIVE" -C "$TMP/bundle"
[ -x "$TMP/bundle/install.sh" ] || die 'release installer is missing'
[ "$(cat "$TMP/bundle/VERSION")" = "$version" ] || die 'release version mismatch'
if [ "$mode" = install ]; then
	"$TMP/bundle/install.sh" "$country"
else
	"$TMP/bundle/install.sh" --update
fi
