#!/bin/sh
# shellcheck disable=SC3043
set -eu

STATE_DIR=${GOFRO_STATE_DIR:-/etc/gofro}
CONFIG_DIR=${GOFRO_CONFIG_DIR:-/etc/config}
UCI=${GOFRO_UCI_COMMAND:-uci}
NFT=${GOFRO_NFT_COMMAND:-nft}
WIFI=${GOFRO_WIFI_COMMAND:-wifi}
WIFI_HELPER=${GOFRO_WIFI_HELPER:-/usr/libexec/gofro/wifi}
INIT_DIR=${GOFRO_INIT_DIR:-/etc/init.d}
IFDOWN=${GOFRO_IFDOWN_COMMAND:-ifdown}
LOCK=${GOFRO_ONBOARDING_LOCK:-/tmp/gofro-onboarding-apply.lock}
STATE=$STATE_DIR/onboarding-state
WINDOW=$STATE_DIR/onboarding-window
PENDING=$STATE_DIR/onboarding-wifi.json
DELAY=$STATE_DIR/onboarding-not-before
BACKUP=$STATE_DIR/onboarding-backup
umask 077
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

stage() {
	umask 077
	printf '%s\n' "$1" > "$STATE.new" || return 1
	chmod 600 "$STATE.new" || return 1
	mv -f "$STATE.new" "$STATE" || return 1
	sync
}
current() {
	[ -e "$STATE" ] || { printf 'complete\n'; return; }
	cat "$STATE"
}
uptime_seconds() {
	local value
	if [ -n "${GOFRO_UPTIME:-}" ]; then value=$GOFRO_UPTIME
	else read -r value _ < /proc/uptime; value=${value%%.*}; fi
	case "$value" in ''|*[!0-9]*) return 1;; esac
	printf '%s\n' "$value"
}
valid_window() {
	local boot deadline extra now
	[ -s "$WINDOW" ] || return 1
	IFS=' ' read -r boot deadline extra < "$WINDOW" || return 1
	[ -z "$extra" ] && [ "${#boot}" = 36 ] || return 1
	case "$deadline" in ''|*[!0-9]*) return 1;; esac
	[ "${#deadline}" -le 10 ] || return 1
	[ "$boot" = "${GOFRO_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id)}" ] || return 1
	now=$(uptime_seconds) || return 1
	[ "$deadline" -gt "$now" ] && [ "$((deadline - now))" -le 900 ]
}
guard() {
	local remove=
	case "$(current)" in
		server|complete)
			if "$UCI" -q get wireless.gofro_setup >/dev/null; then close_setup boot
			else "$NFT" delete table inet gofro_setup_guard >/dev/null 2>&1 || true; return 0; fi;;
	esac
	if "$NFT" list table inet gofro_setup_guard >/dev/null 2>&1; then
		remove='delete table inet gofro_setup_guard'
	fi
	# Replace in one transaction: an active open AP must never see a firewall gap.
	"$NFT" -f - <<EOF
$remove
table inet gofro_setup_guard {
 chain input {
  type filter hook input priority -10; policy accept;
  iifname != "br-gofro-setup" ip daddr 10.203.1.1 drop
  iifname "br-gofro-setup" udp dport { 53, 67 } accept
  iifname "br-gofro-setup" tcp dport { 53, 80, 443 } accept
  iifname "br-gofro-setup" drop
 }
 chain forward { type filter hook forward priority -10; policy accept; iifname "br-gofro-setup" drop; oifname "br-gofro-setup" drop; }
}
EOF
}
close_setup() {
	if "$UCI" -q get wireless.gofro_setup >/dev/null; then
		"$UCI" set wireless.gofro_setup.disabled=1 || return 1
		"$UCI" commit wireless || return 1
	fi
	[ "${1:-}" = boot ] || "$WIFI" reload >/dev/null 2>&1
}
open_setup() {
	local sections section device band chosen='' proto port rule
	sections=$("$UCI" show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p')
	for band in 2g 5g; do
		for section in $sections; do
			[ "$section" != gofro_setup ] || continue
			[ "$("$UCI" -q get "wireless.$section.mode" || true)" = ap ] || continue
			device=$("$UCI" -q get "wireless.$section.device")
			[ "$("$UCI" -q get "wireless.$device.band" || true)" = "$band" ] || continue
			chosen=$device; break
		done
		[ -z "$chosen" ] || break
	done
	[ -n "$chosen" ] || return 1
	for section in $sections; do
		[ "$("$UCI" -q get "wireless.$section.mode" || true)" != ap ] || "$UCI" set "wireless.$section.disabled=1" || return 1
	done
	"$UCI" -q delete wireless.gofro_setup || true
	"$UCI" batch <<EOF
set network.gofro_setup_device=device
set network.gofro_setup_device.name='br-gofro-setup'
set network.gofro_setup_device.type='bridge'
set network.gofro_setup_device.bridge_empty='1'
set network.gofro_setup_device.ipv6='0'
set network.gofro_setup=interface
set network.gofro_setup.proto='static'
set network.gofro_setup.device='br-gofro-setup'
set network.gofro_setup.ipaddr='10.203.1.1'
set network.gofro_setup.netmask='255.255.255.0'
set network.gofro_setup.force_link='1'
set dhcp.gofro_setup=dhcp
set dhcp.gofro_setup.interface='gofro_setup'
set dhcp.gofro_setup.start='2'
set dhcp.gofro_setup.limit='249'
set dhcp.gofro_setup.leasetime='15m'
set dhcp.gofro_setup.ignore='0'
set dhcp.gofro_setup.ra='disabled'
set dhcp.gofro_setup.dhcpv6='disabled'
set wireless.gofro_setup=wifi-iface
set wireless.gofro_setup.device='$chosen'
set wireless.gofro_setup.network='gofro_setup'
set wireless.gofro_setup.mode='ap'
set wireless.gofro_setup.ssid='GofroNET Wi-Fi Setup'
set wireless.gofro_setup.encryption='none'
set wireless.gofro_setup.isolate='1'
set wireless.gofro_setup.disabled='0'
set wireless.$chosen.disabled='0'
set gofro.main.lan_interface='br-gofro-setup'
EOF
	"$UCI" -q delete firewall.gofro_setup || true
	"$UCI" batch <<'EOF'
set firewall.gofro_setup=zone
set firewall.gofro_setup.name='gofro_setup'
add_list firewall.gofro_setup.network='gofro_setup'
set firewall.gofro_setup.input='REJECT'
set firewall.gofro_setup.output='ACCEPT'
set firewall.gofro_setup.forward='REJECT'
EOF
	for rule in udp_67 udp_53 tcp_53 tcp_80 tcp_443; do
		proto=${rule%_*}; port=${rule#*_}
		"$UCI" batch <<EOF
set firewall.gofro_setup_$rule=rule
set firewall.gofro_setup_$rule.src='gofro_setup'
set firewall.gofro_setup_$rule.proto='$proto'
set firewall.gofro_setup_$rule.dest_port='$port'
set firewall.gofro_setup_$rule.target='ACCEPT'
EOF
	done
	for section in network wireless dhcp firewall gofro; do "$UCI" commit "$section" || return 1; done
}
begin() {
	local phase boot now
	phase=$(current)
	case "$phase" in
		admin|wifi) ;;
		complete)
			[ "${GOFRO_ONBOARDING_FRESH:-}" = 1 ] || return 1
			[ ! -e "$STATE_DIR/admin-password" ] && [ ! -e "$STATE_DIR/version" ] && [ ! -e "$STATE_DIR/ap-password" ] || return 1
			;;
		*) return 1;;
	esac
	if [ -e "$STATE_DIR/admin-password" ]; then stage wifi; else stage admin; fi
	rm -f "$WINDOW"
	guard
	boot=${GOFRO_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id)}
	now=$(uptime_seconds)
	umask 077
	printf '%s %s\n' "$boot" "$((now + 900))" > "$WINDOW.new"
	chmod 600 "$WINDOW.new"; mv -f "$WINDOW.new" "$WINDOW"; sync
	open_setup
}
validate() {
	local path="$1" bands seen='' band ssid password size i=0
	size=$(wc -c < "$path"); [ "$size" -le 8192 ] || return 1
	bands=$("$WIFI_HELPER" list | cut -f1 | sort -u)
	[ -n "$bands" ] || return 1
	while :; do
		band=$(jsonfilter -i "$path" -e "@.networks[$i].band" 2>/dev/null || true)
		[ -n "$band" ] || break
		case "$band" in 2g|5g) ;; *) return 1;; esac
		printf '%s\n' "$bands" | grep -qxF "$band" || return 1
		case " $seen " in *" $band "*) return 1;; esac
		seen="$seen $band"
		ssid=$(jsonfilter -i "$path" -e "@.networks[$i].ssid") || return 1
		password=$(jsonfilter -i "$path" -e "@.networks[$i].password") || return 1
		size=$(printf %s "$ssid" | wc -c); [ "$size" -ge 1 ] && [ "$size" -le 32 ] || return 1
		if printf %s "$ssid" | LC_ALL=C grep -q '[[:cntrl:]]'; then return 1; fi
		size=$(printf %s "$password" | wc -c); [ "$size" -ge 8 ] && [ "$size" -le 63 ] || return 1
		if printf %s "$password" | LC_ALL=C grep -q '[^ -~]'; then return 1; fi
		i=$((i + 1))
	done
	[ "$i" -gt 0 ] || return 1
	for band in $bands; do case " $seen " in *" $band "*) ;; *) return 1;; esac; done
}
wifi() {
	local config now
	case "$(current)" in admin|wifi) ;; *) return 1;; esac
	valid_window && [ -s "$STATE_DIR/admin-password" ] || return 1
	umask 077
	cat > "$PENDING.new"
	validate "$PENDING.new" || { rm -f "$PENDING.new"; return 1; }
	mkdir -p "$BACKUP"
	for config in network wireless dhcp gofro; do cp -p "$CONFIG_DIR/$config" "$BACKUP/$config" || return 1; done
	mv -f "$PENDING.new" "$PENDING"
	now=$(uptime_seconds)
	printf '%s\n' "$((now + 3))" > "$DELAY.new"
	chmod 600 "$DELAY.new"; mv -f "$DELAY.new" "$DELAY"
	rm -f "$STATE_DIR/onboarding-error"
	stage wifi_applying
}
reload_network() {
	"$INIT_DIR/network" reload || return 1
	"$INIT_DIR/firewall" reload || return 1
	"$INIT_DIR/dnsmasq" restart || return 1
	"$WIFI" reload
}
restore_files() {
	local config
	for config in network wireless dhcp gofro; do
		cp -p "$BACKUP/$config" "$CONFIG_DIR/$config.new" || return 1
		mv -f "$CONFIG_DIR/$config.new" "$CONFIG_DIR/$config" || return 1
		"$UCI" revert "$config" || return 1
	done
	sync
}
secured() {
	local section device band found=0
	for section in $("$UCI" show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
		[ "$("$UCI" -q get "wireless.$section.mode" || true)" = ap ] || continue
		[ "$("$UCI" -q get "wireless.$section.disabled" || true)" != 1 ] || continue
		device=$("$UCI" -q get "wireless.$section.device") || return 1
		band=$("$UCI" -q get "wireless.$device.band") || return 1
		case "$band" in 2g|5g) ;; *) continue;; esac
		[ "$("$UCI" -q get "wireless.$section.network")" = lan ] || return 1
		[ "$("$UCI" -q get "wireless.$section.encryption")" = sae-mixed ] || return 1
		[ -n "$("$UCI" -q get "wireless.$section.key")" ] || return 1
		"$WIFI" status | jsonfilter -e "@.$device.up" | grep -qx true || return 1
		found=1
	done
	[ "$found" = 1 ] && ! "$UCI" -q get wireless.gofro_setup >/dev/null
}
apply() (
	local due now section device band ssid password i=0 result=1
	[ "$(current)" = wifi_applying ] || exit 0
	IFS= read -r due < "$DELAY" || exit 1
	case "$due" in ''|*[!0-9]*) exit 1;; esac
	now=$(uptime_seconds); [ "$now" -ge "$due" ] || exit 0
	mkdir "$LOCK" 2>/dev/null || exit 0
	# shellcheck disable=SC2317,SC2329
	cleanup_apply() {
		local code=$?
		trap - EXIT HUP INT TERM
		set +e
		if [ "$result" != 0 ]; then
			guard
			if restore_files && stage wifi; then
				printf 'wifi-apply-failed\n' > "$STATE_DIR/onboarding-error"
				valid_window || close_setup boot
				reload_network
			fi
		fi
		rmdir "$LOCK" 2>/dev/null || true
		exit "$code"
	}
	trap cleanup_apply EXIT
	trap 'exit 1' HUP INT TERM
	valid_window && validate "$PENDING" && [ -s "$STATE_DIR/admin-password" ] || exit 1
	while :; do
		band=$(jsonfilter -i "$PENDING" -e "@.networks[$i].band" 2>/dev/null || true); [ -n "$band" ] || break
		ssid=$(jsonfilter -i "$PENDING" -e "@.networks[$i].ssid"); password=$(jsonfilter -i "$PENDING" -e "@.networks[$i].password")
		# One commit/reload after all bands, never one reload per password.
		printf '%s\n' "$password" | "$WIFI_HELPER" stage "$band" "$ssid" || break
		i=$((i + 1))
	done
	if [ "$i" = "$(jsonfilter -i "$PENDING" -e '@.networks[*].band' | wc -l | tr -d ' ')" ]; then
		for section in $("$UCI" show wireless | sed -n 's/^wireless\.\([^=]*\)=wifi-iface$/\1/p'); do
			[ "$section" != gofro_setup ] || continue
			[ "$("$UCI" -q get "wireless.$section.mode" || true)" = ap ] || continue
			device=$("$UCI" -q get "wireless.$section.device"); band=$("$UCI" -q get "wireless.$device.band" || true)
			case "$band" in 2g|5g) ;; *) continue;; esac
			"$UCI" set "wireless.$section.network=lan"
			"$UCI" set "wireless.$section.disabled=0"
			"$UCI" set "wireless.$device.disabled=0"
		done
		"$UCI" -q delete wireless.gofro_setup || true
		"$UCI" -q delete network.gofro_setup || true
		"$UCI" -q delete network.gofro_setup_device || true
		"$UCI" -q delete dhcp.gofro_setup || true
		"$UCI" set network.lan.ipaddr=10.203.1.1
		"$UCI" set network.lan.netmask=255.255.255.0
		"$UCI" set gofro.main.lan_interface=br-lan
		for section in wireless network dhcp gofro; do "$UCI" commit "$section" || exit 1; done
		"$IFDOWN" gofro_setup >/dev/null 2>&1 || true
		if reload_network; then
			# DFS/CAC can take minutes; retain isolation until ready or the setup window closes.
			i=0
			while [ "$i" -lt 900 ] && valid_window; do
				sleep 1
				if secured; then result=2; break; fi
				i=$((i + 1))
			done
		fi
	fi
	if [ "$result" = 2 ]; then
		stage server
		result=0
		"$NFT" delete table inet gofro_setup_guard >/dev/null 2>&1 || true
		rm -f "$WINDOW" "$PENDING" "$DELAY" "$STATE_DIR/onboarding-error"
		rm -rf "$BACKUP"
		"$INIT_DIR/gofro-agent" restart
	else
		exit 1
	fi
)
recover() {
	case "$(current)" in
		server|complete) guard; return 0;;
		wifi_applying) restore_files; stage wifi; rmdir "$LOCK" 2>/dev/null || true;;
		admin|wifi) ;;
		*) guard; close_setup boot; return;;
	esac
	valid_window || close_setup boot
	guard
}
complete() {
	case "$(current)" in complete) return 0;; server) ;; *) return 1;; esac
	secured || return 1
	rm -f "$STATE" "$WINDOW" "$PENDING" "$DELAY" "$STATE_DIR/onboarding-error"
	rm -rf "$BACKUP"
	sync
	"$INIT_DIR/gofro-onboarding" stop >/dev/null 2>&1 || true
}
watch() {
	local expired=0
	while [ -e "$STATE" ]; do
		case "$(current)" in
			admin|wifi) if valid_window; then expired=0; elif [ "$expired" = 0 ]; then close_setup; expired=1; fi;;
			wifi_applying) if valid_window; then "$0" apply || true; else recover; close_setup; fi;;
			server) ;;
			*) if [ "$expired" = 0 ]; then guard; close_setup; expired=1; fi;;
		esac
		sleep 1
	done
	if "$UCI" -q get wireless.gofro_setup >/dev/null; then close_setup; fi
}
[ "$#" = 1 ] || exit 2
case "$1" in begin|wifi|apply|complete|watch|guard|recover) "$1";; *) exit 2;; esac
