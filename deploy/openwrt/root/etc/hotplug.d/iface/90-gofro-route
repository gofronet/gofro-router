#!/bin/sh

expected="$(uci -q get gofro.main.interface || echo gt0)"
agent_init=${GOFRO_AGENT_INIT:-/etc/init.d/gofro-agent}
network_command=${GOFRO_NETWORK_COMMAND:-/usr/libexec/gofro/network}
mode_command=${GOFRO_MODE_COMMAND:-/usr/libexec/gofro/mode}

# LAN changes restart the agent, which snapshots ubus once and passes those exact values to mode.
if [ "$INTERFACE" = lan ] && { [ "$ACTION" = ifup ] || [ "$ACTION" = ifupdate ]; }; then
	"$agent_init" restart
fi

[ "$INTERFACE" = "$expected" ] || exit 0

case "$ACTION" in
	ifup|ifdown)
		[ "$expected" = gt0 ] && [ "${DEVICE:-$expected}" = gt0 ] || exit 1
		snapshot="$("$network_command")" || exit 1
		lan_device="$(printf '%s' "$snapshot" | jsonfilter -e '@.device')" || exit 1
		lan_subnet="$(printf '%s' "$snapshot" | jsonfilter -e '@.subnet')" || exit 1
		case "$ACTION" in ifup) mode_action=tunnel-up ;; ifdown) mode_action=tunnel-down ;; esac
		"$mode_command" "$mode_action" "$lan_device" "$lan_subnet"
		;;
esac
