#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=8

recover_update() {
	app_root=${APP_ROOT:-/usr/lib/gofro}
	releases=$app_root/releases
	current=$app_root/current
	state_dir=${STATE_DIR:-/etc/gofro}
	pending=$state_dir/update-previous
	if [ ! -s "$pending" ]; then
		return 0
	fi

	# A failed retry must not leave an earlier restoration witness usable by S99.
	rm -f "$state_dir/update-restored" || return 1
	IFS= read -r previous < "$pending" || return 1
	backup="$(sed -n '2p' "$pending")"
	version=${previous#"$releases/"}
	case "$version" in ''|*/*|*[!0-9.]*) return 1 ;; esac
	[ "$previous" = "$releases/$version" ] || return 1
	[ -d "$previous" ] || return 1
	[ -d "$backup" ] || return 1
	# boot is also callable on a live router; native stop handles absent instances.
	/etc/init.d/gofro-agent stop || return 1
	/etc/init.d/gofro-relay stop || return 1
	"$backup/restore" restore "$backup" || return 1

	current_tmp=$app_root/current.new.$$
	version_tmp=$state_dir/version.new
	rm -f "$current_tmp" "$version_tmp"
	ln -s "$previous" "$current_tmp" || return 1
	mv -fT "$current_tmp" "$current" || return 1
	sync || return 1
	printf '%s\n' "$version" > "$version_tmp" || return 1
	chmod 644 "$version_tmp" || return 1
	mv -f "$version_tmp" "$state_dir/version" || return 1
	# This witnesses persistent installer-state restoration, not runtime reconciliation.
	printf '%s\n' "$previous" > "$state_dir/update-restored" || return 1
	/etc/init.d/gofro-agent enable || return 1
	/etc/init.d/gofro-relay enable || return 1
	sync
}

boot() {
	# Restore the release before networking.
	if ! recover_update; then
		/etc/init.d/gofro-agent stop
		/etc/init.d/gofro-relay stop
		/etc/init.d/gofro-agent disable
		/etc/init.d/gofro-relay disable
		return 1
	fi
}
