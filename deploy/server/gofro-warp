#!/usr/bin/env bash
set -euo pipefail

# WARP payload uses kernel WireGuard; wgcf is registration-only, never a proxy.
# The plaintext interface lives in an owned namespace, not the VPS routing domain.
NS=gofro-warp
VETH=gofro-warp0
UPLINK=gofro-warp1
HOST=169.254.203.1
PEER=169.254.203.2
SOURCES=10.202.1.0/24
TABLE=10900
STATE=/etc/gofro/warp
WIREGUARD=CloudflareWARP
WARP_MTU=1420
WGCF=/usr/local/libexec/gofro-wgcf
WGCF_SHA256=4fb7a136aa470ece11d17949c7db07b040ec9c604742dc8680bcf1889f85d0c8
WG_INTERFACE=gt0
WAN_INTERFACE=

die() { printf 'gofro WARP: %s\n' "$*" >&2; exit 1; }
valid_interface() { [[ $1 =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]]; }
# Drain command-output filters: grep -q can make a match fail via SIGPIPE/pipefail.
protected_file() {
  [[ -f $1 && ! -L $1 && $(stat -c '%u:%h' "$1") == 0:1 ]] &&
    (( (8#$(stat -c '%a' "$1") & 8#022) == 0 ))
}
valid_ipv4() {
  local octet
  local -a octets
  [[ $1 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  IFS=. read -r -a octets <<< "$1"
  [[ ${#octets[@]} == 4 ]] || return 1
  for octet in "${octets[@]}"; do
    [[ $octet =~ ^[0-9]{1,3}$ ]] && (( 10#$octet <= 255 )) || return 1
  done
  (( 10#${octets[0]} > 0 && 10#${octets[0]} != 127 && 10#${octets[0]} < 224 ))
}
read_profile() {
  local profile=$1 line section='' key value address endpoint
  local interfaces=0 peers=0
  local -A fields=()
  if ! protected_file "$profile" || [[ $(stat -c '%a' "$profile") != 600 ]]; then die 'unsafe or missing WARP WireGuard profile'; fi
  (( $(stat -c '%s' "$profile") <= 8192 )) || die 'oversized WireGuard profile'
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    case $line in
      ''|'#'*) continue ;;
      '[Interface]') section=Interface; interfaces=$((interfaces + 1)); continue ;;
      '[Peer]') section=Peer; peers=$((peers + 1)); continue ;;
    esac
    [[ $line == *=* ]] || die 'invalid WireGuard profile line'
    key=${line%%=*}; key=${key//[[:space:]]/}
    value=${line#*=}; value=${value//[[:space:]]/}
    case "$section:$key" in
      Interface:PrivateKey|Interface:Address|Interface:DNS|Interface:MTU|Peer:PublicKey|Peer:AllowedIPs|Peer:Endpoint|Peer:PersistentKeepalive) ;;
      *) die 'unexpected WireGuard profile setting (hooks are never executed)' ;;
    esac
    [[ ! -v fields[$key] ]] || die 'duplicate WireGuard profile setting'
    fields[$key]=$value
  done < "$profile"
  [[ $interfaces == 1 && $peers == 1 ]] || die 'expected one WireGuard interface and peer'
  PROFILE_PRIVATE=${fields[PrivateKey]:-}
  PROFILE_PUBLIC=${fields[PublicKey]:-}
  [[ $PROFILE_PRIVATE =~ ^[A-Za-z0-9+/]{43}=$ && $PROFILE_PUBLIC =~ ^[A-Za-z0-9+/]{43}=$ ]] || die 'invalid WireGuard key'
  address=${fields[Address]:-}; address=${address%%,*}
  if [[ $address != */32 ]] || ! valid_ipv4 "${address%/32}"; then die 'invalid WireGuard IPv4 address'; fi
  PROFILE_ADDRESS=$address
  [[ ${fields[AllowedIPs]:-} == '0.0.0.0/0,::/0' || ${fields[AllowedIPs]:-} == '0.0.0.0/0' ]] || die 'unexpected WireGuard allowed IPs'
  endpoint=${fields[Endpoint]:-}
  [[ $endpoint =~ ^([a-zA-Z0-9][a-zA-Z0-9.-]*):([1-9][0-9]{0,4})$ ]] || die 'invalid IPv4 WireGuard endpoint'
  PROFILE_HOST=${BASH_REMATCH[1]}; PROFILE_PORT=${BASH_REMATCH[2]}
  (( PROFILE_PORT <= 65535 )) || die 'invalid WireGuard endpoint port'
  # DNS, MTU and IPv6 from wg-quick profiles are not applied to the VPS.
  # No profile text is sourced or passed to wg-quick; only validated fields above.
}
read_network() {
  [[ -d $STATE && ! -L $STATE && $(stat -c '%u:%a' "$STATE") == 0:700 ]] || die 'unsafe WARP state directory'
  protected_file "$STATE/network" || die 'unsafe or missing WARP network configuration'
  local key value seen_wg=0 seen_wan=0
  while IFS='=' read -r key value; do
    valid_interface "$value" || die 'invalid WARP network configuration'
    case $key in
      WG_INTERFACE) [[ $value == "$WG_INTERFACE" && $seen_wg == 0 ]] || die 'WireGuard interface mismatch'; seen_wg=1 ;;
      WAN_INTERFACE) [[ $seen_wan == 0 ]] || die 'duplicate WAN interface'; WAN_INTERFACE=$value; seen_wan=1 ;;
      *) die 'unrecognized WARP network setting' ;;
    esac
  done < "$STATE/network"
  [[ $seen_wg == 1 && $seen_wan == 1 && $WAN_INTERFACE != "$VETH" ]] || die 'incomplete WARP network configuration'
}

render_firewall() {
  cat <<EOF
table inet gofro_server {
  chain input { type filter hook input priority filter; policy accept; iifname "$WG_INTERFACE" drop; }
  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "$WG_INTERFACE" ip saddr $SOURCES oifname != "$VETH" drop
    iifname "$WG_INTERFACE" ip saddr $SOURCES oifname "$VETH" accept
    iifname "$VETH" oifname "$WG_INTERFACE" ct state established,related accept
    iifname "$WG_INTERFACE" oifname "$WAN_INTERFACE" accept
    iifname "$WAN_INTERFACE" oifname "$WG_INTERFACE" ct state established,related accept
    iifname "$WG_INTERFACE" drop
    oifname "$WG_INTERFACE" drop
  }
  chain postrouting { type nat hook postrouting priority srcnat; policy accept; iifname "$WG_INTERFACE" oifname "$WAN_INTERFACE" masquerade; }
}
EOF
}
render_legacy_firewall() {
  # Exact recognition prevents replacing operator-added firewall rules.
  cat <<EOF
table inet gofro_server {
  chain input { type filter hook input priority filter; policy accept; iifname "$WG_INTERFACE" drop; }
  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "$WG_INTERFACE" oifname "$WAN_INTERFACE" accept
    iifname "$WAN_INTERFACE" oifname "$WG_INTERFACE" ct state established,related accept
    iifname "$WG_INTERFACE" drop
    oifname "$WG_INTERFACE" drop
  }
  chain postrouting { type nat hook postrouting priority srcnat; policy accept; iifname "$WG_INTERFACE" oifname "$WAN_INTERFACE" masquerade; }
}
EOF
}
render_namespace_firewall() {
  cat <<EOF
table inet gofro_warp {
  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    iifname "$UPLINK" oifname "CloudflareWARP" ip saddr $SOURCES accept
    iifname "CloudflareWARP" oifname "$UPLINK" ct state established,related accept
  }
  chain mss {
    type filter hook forward priority mangle; policy accept;
    tcp flags & (syn | rst) == syn tcp option maxseg size > $((WARP_MTU - 40)) tcp option maxseg size set $((WARP_MTU - 40))
  }
  chain postrouting { type nat hook postrouting priority srcnat; policy accept; ip saddr $SOURCES oifname "CloudflareWARP" masquerade; }
}
EOF
}

prepare() {
  local temporary wan
  if [[ -e $STATE || -L $STATE ]]; then
    [[ -d $STATE && ! -L $STATE && $(stat -c '%u:%a' "$STATE") == 0:700 ]] || die 'unsafe WARP state directory'
  fi
  protected_file /etc/gofro/server.nft || die 'managed server firewall is missing or unsafe'
  wan=$(awk -v interface="\"$WG_INTERFACE\"" '$1 == "iifname" && $2 == interface && $3 == "oifname" && $5 == "accept" { gsub(/"/, "", $4); print $4; count++ } END { if (count != 1) exit 1 }' /etc/gofro/server.nft) || die 'cannot identify managed WAN'
  valid_interface "$wan" || die 'invalid managed WAN'
  WAN_INTERFACE=$wan
  temporary=$(mktemp -d)
  render_firewall > "$temporary/new"
  render_legacy_firewall > "$temporary/old"
  if ! cmp -s /etc/gofro/server.nft "$temporary/new" && ! cmp -s /etc/gofro/server.nft "$temporary/old"; then
    rm -rf "$temporary"
    die 'server firewall has custom changes; refusing automatic replacement'
  fi
  { printf 'delete table inet gofro_server\n'; cat "$temporary/new"; } > "$temporary/apply"
  if ! nft -c -f "$temporary/apply" || ! nft -f "$temporary/apply"; then
    rm -rf "$temporary"
    die 'could not atomically install WARP source isolation'
  fi
  install -m 600 "$temporary/new" /etc/gofro/server.nft
  install -d -m 700 "$STATE"
  printf 'WG_INTERFACE=%s\nWAN_INTERFACE=%s\n' "$WG_INTERFACE" "$WAN_INTERFACE" > "$temporary/network"
  install -m 600 "$temporary/network" "$STATE/network"
  printf 'kernel-wireguard-v1\n' > "$temporary/backend"
  install -m 600 "$temporary/backend" "$STATE/backend"
  rm -rf "$temporary"
}

check_routes() {
  local rules routes line existing
  rules=$(ip -4 -N rule show)
  existing=$(awk '$1 == "10900:" { $1=$1; print }' <<< "$rules")
  [[ -z $existing || $existing == "10900: from $SOURCES iif $WG_INTERFACE lookup $TABLE" ]] || die 'foreign policy rule at priority 10900'
  routes=$(LC_ALL=C ip -4 -N -o route show table "$TABLE" 2>&1) || {
    [[ $routes == 'Error: ipv4: FIB table does not exist.
Dump terminated' ]] || die 'cannot inspect WARP routing table'
    routes=
  }
  routes=$(awk '{$1=$1; if (NF) print}' <<< "$routes")
  while IFS= read -r line; do
    [[ -z $line || $line == "unreachable default proto 186 metric 32767" || $line == "7 default proto 186 metric 32767" || $line == "default via $PEER dev $VETH proto 186 metric 10" ]] || die 'foreign routes in WARP routing table'
  done <<< "$routes"
  existing=$(ip -4 -N -o route show exact "$SOURCES" | awk '{$1=$1; if (NF) print}')
  [[ -z $existing || $existing == "$SOURCES dev $WG_INTERFACE proto 186 scope 253" ]] || die 'foreign WARP source return route'
  [[ -n $(ip -4 -o route show exact 169.254.203.0/30) ]] && {
    ip -d link show dev "$VETH" | grep -F 'alias gofro-warp-v1' >/dev/null || die 'WARP link network is already in use'
  }
  return 0
}

network_up() {
  read_network
  check_routes
  if ip link show dev "$VETH" >/dev/null 2>&1; then
    ip -d link show dev "$VETH" | grep -F 'alias gofro-warp-v1' >/dev/null || die 'foreign WARP veth interface'
    die 'WARP namespace still exists; stop its services before repair'
  fi
  if ip netns list | grep -E '^gofro-warp( |$)' >/dev/null; then die 'foreign or stale WARP namespace; manual inspection required'; fi
  ip route replace unreachable default table "$TABLE" metric 32767 proto 186
  if ! ip -4 -N rule show | grep '^10900:' >/dev/null; then ip rule add pref "$TABLE" from "$SOURCES" iif "$WG_INTERFACE" lookup "$TABLE"; fi
  ip netns add "$NS"
  # Install the namespace kill switch BEFORE links, forwarding or WARP start.
  render_namespace_firewall | ip netns exec "$NS" nft -f -
  ip link add "$VETH" type veth peer name "$UPLINK"
  ip link set dev "$VETH" alias gofro-warp-v1
  ip link set "$UPLINK" netns "$NS"
  ip address add "$HOST/30" dev "$VETH"
  ip link set "$VETH" up
  ip -n "$NS" address add "$PEER/30" dev "$UPLINK"
  ip -n "$NS" link set lo up
  ip -n "$NS" link set "$UPLINK" up
  ip -n "$NS" route add "$SOURCES" via "$HOST"
  # There is deliberately NO namespace default via the host: only WireGuard
  # may supply its Internet route. Its encrypted UDP socket lives in the host.
  ip netns exec "$NS" sysctl -qw net.ipv4.ip_forward=1 net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0
  sysctl -qw "net.ipv4.conf.$VETH.rp_filter=2"
  ip route replace "$SOURCES" dev "$WG_INTERFACE" proto 186
  ip route replace default via "$PEER" dev "$VETH" table "$TABLE" metric 10 proto 186
}

network_down() {
  read_network
  check_routes
  wireguard_down
  # The policy rule and unreachable default intentionally survive shutdown.
  ip route replace unreachable default table "$TABLE" metric 32767 proto 186
  if ip link show dev "$VETH" >/dev/null 2>&1; then
    ip -d link show dev "$VETH" | grep -F 'alias gofro-warp-v1' >/dev/null || die 'refusing to delete a foreign veth'
    ip route del default via "$PEER" dev "$VETH" table "$TABLE" metric 10 proto 186 2>/dev/null || true
    ip link delete "$VETH"
    ip netns delete "$NS"
  elif ip netns list | grep -E '^gofro-warp( |$)' >/dev/null; then
    die 'namespace without its owned veth requires manual inspection'
  fi
}

write_units() {
  local temporary unit
  temporary=$(mktemp -d)
  printf 'nameserver 1.1.1.1\nnameserver 1.0.0.1\n' > "$temporary/resolv.conf"
  cat > "$temporary/gofro-warp-network.service" <<EOF
[Unit]
Description=Gofro isolated WARP egress network
Requires=wg-quick@$WG_INTERFACE.service
After=wg-quick@$WG_INTERFACE.service
Before=gofro-warp.service
PartOf=wg-quick@$WG_INTERFACE.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gofro-warp network-up $WG_INTERFACE
ExecStopPost=/usr/local/sbin/gofro-warp network-down $WG_INTERFACE
[Install]
WantedBy=multi-user.target
EOF
  cat > "$temporary/gofro-warp.service" <<EOF
[Unit]
Description=Gofro kernel WireGuard WARP egress
Requires=gofro-warp-network.service
After=gofro-warp-network.service
PartOf=gofro-warp-network.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gofro-warp connect $WG_INTERFACE
ExecStopPost=/usr/local/sbin/gofro-warp disconnect $WG_INTERFACE
TimeoutStartSec=90
[Install]
WantedBy=multi-user.target
EOF
  for unit in gofro-warp-network.service gofro-warp.service; do
    if [[ -e /etc/systemd/system/$unit || -L /etc/systemd/system/$unit ]]; then
      if ! protected_file "/etc/systemd/system/$unit" || ! cmp -s "$temporary/$unit" "/etc/systemd/system/$unit"; then
        rm -rf "$temporary"
        die 'custom or foreign WARP service unit; refusing to overwrite it'
      fi
    fi
  done
  if [[ -e /etc/netns/gofro-warp || -L /etc/netns/gofro-warp ]]; then
    if [[ ! -d /etc/netns/gofro-warp || -L /etc/netns/gofro-warp || $(stat -c '%u:%a' /etc/netns/gofro-warp) != 0:755 ]]; then
      rm -rf "$temporary"
      die 'unsafe WARP namespace resolver directory'
    fi
  fi
  if [[ -e /etc/netns/gofro-warp/resolv.conf || -L /etc/netns/gofro-warp/resolv.conf ]]; then
    if ! protected_file /etc/netns/gofro-warp/resolv.conf || ! cmp -s "$temporary/resolv.conf" /etc/netns/gofro-warp/resolv.conf; then
      rm -rf "$temporary"
      die 'custom or foreign WARP namespace resolver; refusing to overwrite it'
    fi
  fi
  install -d -m 755 /etc/netns/gofro-warp
  install -m 644 "$temporary/resolv.conf" /etc/netns/gofro-warp/resolv.conf
  for unit in gofro-warp-network.service gofro-warp.service; do install -m 644 "$temporary/$unit" "/etc/systemd/system/$unit"; done
  rm -rf "$temporary"
  systemctl daemon-reload
}

owned_wireguard() {
  ip "$@" -d link show dev "$WIREGUARD" | grep -F 'alias gofro-warp-wireguard-v1' >/dev/null || die 'foreign WARP WireGuard interface'
  ip "$@" -d link show dev "$WIREGUARD" | grep -E '(^|[[:space:]])wireguard([[:space:]]|$)' >/dev/null || die 'WARP interface is not kernel WireGuard'
}
wireguard_down() {
  read_network
  check_routes
  if ip link show dev "$WIREGUARD" >/dev/null 2>&1; then
    owned_wireguard
    ip link delete "$WIREGUARD"
  fi
  if ip -n "$NS" link show dev "$WIREGUARD" >/dev/null 2>&1; then
    ip -d link show dev "$VETH" | grep -F 'alias gofro-warp-v1' >/dev/null || die 'foreign WARP namespace'
    owned_wireguard -n "$NS"
    ip -n "$NS" link delete "$WIREGUARD"
  fi
}
connect() {
  read_network
  check_routes
  read_profile "$STATE/profile.conf"
  local attempt trace address temporary
  address=$PROFILE_HOST
  if ! valid_ipv4 "$address"; then
    address=$(getent ahostsv4 "$PROFILE_HOST" | awk 'NR == 1 { address=$1 } END { print address }') || die 'cannot resolve WARP WireGuard endpoint'
  fi
  valid_ipv4 "$address" || die 'WARP endpoint has no usable IPv4 address'
  ip -d link show dev "$VETH" | grep -F 'alias gofro-warp-v1' >/dev/null || die 'WARP namespace is not prepared'
  if ip link show dev "$WIREGUARD" >/dev/null 2>&1 || ip -n "$NS" link show dev "$WIREGUARD" >/dev/null 2>&1; then
    die 'WARP interface already exists; stop its service before reconnecting'
  fi
  # Birthplace socket stays on the VPS WAN when the plaintext interface moves.
  # This uses the kernel driver, not wireguard-go, a proxy, or a WARP daemon.
  ip link add "$WIREGUARD" type wireguard
  ip link set "$WIREGUARD" alias gofro-warp-wireguard-v1
  ip link set "$WIREGUARD" netns "$NS"
  temporary=$(mktemp -d "$STATE/.key.XXXXXX")
  (umask 077; printf '%s\n' "$PROFILE_PRIVATE" > "$temporary/private")
  if ! ip netns exec "$NS" wg set "$WIREGUARD" private-key "$temporary/private" \
    peer "$PROFILE_PUBLIC" endpoint "$address:$PROFILE_PORT" allowed-ips 0.0.0.0/0 persistent-keepalive 25; then
    rm -rf "$temporary"
    die 'could not configure kernel WireGuard'
  fi
  rm -rf "$temporary"
  unset PROFILE_PRIVATE
  ip -n "$NS" address add "$PROFILE_ADDRESS" dev "$WIREGUARD"
  ip -n "$NS" link set "$WIREGUARD" mtu "$WARP_MTU" up
  ip -n "$NS" route add default dev "$WIREGUARD"
  for ((attempt=0; attempt<12; attempt++)); do
    if trace=$(ip netns exec "$NS" curl -4 --noproxy '*' --interface "$WIREGUARD" --fail --silent --show-error --max-time 5 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null) && grep -Eq '^warp=(on|plus)$' <<< "$trace"; then return; fi
    sleep 2
  done
  die 'WARP WireGuard connection could not be verified; selected traffic remains blocked (no MASQUE or ordinary-exit fallback)'
}

register_profile() {
  local temporary
  umask 077
  if [[ -e $STATE/profile.conf || -L $STATE/profile.conf ]]; then
    read_profile "$STATE/profile.conf"
    unset PROFILE_PRIVATE
    return
  fi
  temporary=$(mktemp -d "$STATE/.registration.XXXXXX")
  if [[ -e $STATE/account.toml || -L $STATE/account.toml ]]; then
    if ! protected_file "$STATE/account.toml" || [[ $(stat -c '%a' "$STATE/account.toml") != 600 ]]; then die 'unsafe WARP registration file'; fi
  elif ! timeout 120 "$WGCF" --config "$STATE/account.toml" register --accept-tos > "$temporary/register.log" 2>&1; then
    die "WARP WireGuard registration failed; private diagnostics: $temporary/register.log"
  fi
  if ! timeout 120 "$WGCF" --config "$STATE/account.toml" generate --keepalive 25 --profile "$temporary/profile.conf" > "$temporary/generate.log" 2>&1; then
    die "WARP WireGuard profile generation failed; private diagnostics: $temporary/generate.log"
  fi
  read_profile "$temporary/profile.conf"
  install -m 600 "$temporary/profile.conf" "$STATE/profile.conf"
  unset PROFILE_PRIVATE
  rm -rf "$temporary"
}
enable() {
  umask 077
  if [[ ! -e $STATE/network ]]; then
    if command -v warp-svc >/dev/null 2>&1 || [[ -e /var/lib/cloudflare-warp/reg.json || -e /etc/systemd/system/warp-svc.service.d/gofro.conf || -e /etc/systemd/system/gofro-warp-network.service || -e /etc/systemd/system/gofro-warp.service || -e /etc/netns/gofro-warp ]]; then
      die 'existing unmanaged WARP installation; refusing to take it over'
    fi
  else
    read_network
    if ! protected_file "$STATE/backend" || [[ $(< "$STATE/backend") != kernel-wireguard-v1 ]]; then die 'existing non-native WARP setup; refusing an automatic takeover'; fi
  fi
  # shellcheck disable=SC1091
  source /etc/os-release
  case "${ID:-}:${VERSION_CODENAME:-}" in
    debian:bookworm|debian:trixie|ubuntu:jammy|ubuntu:noble|ubuntu:resolute) ;;
    *) die 'WARP automatic installation supports Debian 12/13 and Ubuntu 22.04/24.04/26.04' ;;
  esac
  [[ -x $WGCF && $(sha256sum "$WGCF") == "$WGCF_SHA256  $WGCF" ]] || die 'signed bundle registration utility is missing or its pinned checksum differs'
  if ! command -v wg >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
    apt-get update >/dev/null
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends wireguard-tools ca-certificates curl iproute2 >/dev/null
  fi
  prepare
  write_units
  systemctl enable --now gofro-warp-network.service >/dev/null
  register_profile
  # A failed connect is an enabled-but-disconnected, fail-closed desired state.
  install -m 600 /dev/null "$STATE/enabled"
  systemctl enable gofro-warp.service >/dev/null
  systemctl restart gofro-warp.service
}

disable() {
  [[ -e $STATE/network ]] || return 0
  read_network
  # Remove intent first so a concurrent status never reports a live exit.
  rm -f "$STATE/enabled"
  systemctl disable --now gofro-warp.service >/dev/null
  # Leave namespace firewall, source return routes and blackhole protection intact.
}
status() {
  local installed=false enabled=false connected=false handshake now
  if [[ -e $STATE/network ]]; then
    read_network
    if protected_file "$STATE/profile.conf" && [[ $(stat -c '%a' "$STATE/profile.conf") == 600 ]]; then installed=true; fi
    [[ ! -f $STATE/enabled ]] || enabled=true
    if [[ $installed == true && $enabled == true ]] && systemctl is-active --quiet gofro-warp.service; then
      handshake=$(ip netns exec "$NS" wg show "$WIREGUARD" latest-handshakes 2>/dev/null | awk 'NF == 2 { value=$2; count++ } END { if (count == 1) print value }') || handshake=
      now=$(date +%s)
      if [[ $handshake =~ ^[0-9]{1,12}$ ]] && (( handshake > 0 && now >= handshake && now - handshake <= 180 )); then connected=true; fi
    fi
  fi
  printf '{"installed":%s,"enabled":%s,"connected":%s}\n' "$installed" "$enabled" "$connected"
}

case ${1:-} in
  render-firewall|render-legacy-firewall)
    if [[ $# != 3 ]] || ! valid_interface "$2" || ! valid_interface "$3"; then die 'invalid render arguments'; fi
    WG_INTERFACE=$2; WAN_INTERFACE=$3
    if [[ $1 == render-firewall ]]; then render_firewall; else render_legacy_firewall; fi
    exit 0 ;;
  render-namespace-firewall) render_namespace_firewall; exit 0 ;;
esac
if [[ $EUID != 0 || $# != 2 ]] || ! valid_interface "$2"; then die 'usage: gofro-warp enable|disable|status|connect|disconnect|network-up|network-down INTERFACE (as root)'; fi
WG_INTERFACE=$2
case $1 in
  enable) enable ;;
  disable) disable ;;
  status) status ;;
  connect) connect ;;
  disconnect) wireguard_down ;;
  network-up) network_up ;;
  network-down) network_down ;;
  *) die 'unknown WARP operation' ;;
esac
