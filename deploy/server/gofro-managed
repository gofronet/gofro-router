#!/usr/bin/env bash
set -euo pipefail

command=${SSH_ORIGINAL_COMMAND:-}

valid_endpoint() {
  [[ $1 =~ ^(\[[0-9a-f:]+\]|[0-9]{1,3}(\.[0-9]{1,3}){3}):8443$ ]]
}

case $command in
  version)
    exec /usr/local/bin/gofro-router-server --version
    ;;
  update)
    exec timeout 900 /usr/local/sbin/gofro-server-install >/dev/null
    ;;
  create-router-profile\ *)
    endpoint=${command#create-router-profile }
    valid_endpoint "$endpoint" || exit 126
    exec timeout 30 /usr/local/bin/gofro-router-server create-profile \
      --endpoint "$endpoint" --subnet 10.203.1.0/24
    ;;
  create-profile\ *)
    endpoint=${command#create-profile }
    valid_endpoint "$endpoint" || exit 126
    exec timeout 30 /usr/local/bin/gofro-router-server create-profile --endpoint "$endpoint"
    ;;
  remove-router-peer\ *)
    public_key=${command#remove-router-peer }
    [[ $public_key =~ ^[A-Za-z0-9+/]{43}=$ ]] || exit 126
    exec timeout 30 /usr/local/bin/gofro-router-server remove-peer \
      --public-key "$public_key" --subnet 10.203.1.0/24
    ;;
  *)
    exit 126
    ;;
esac
