#!/usr/bin/env bash
set -euo pipefail

command=${SSH_ORIGINAL_COMMAND:-}

# Keep validation regexes from overwriting the command's BASH_REMATCH captures.
valid_endpoint() (
  local host octet
  [[ $1 =~ ^(\[[0-9a-f:]+\]|[0-9]{1,3}(\.[0-9]{1,3}){3}):8443$ ]] || return 1
  host=${1%:8443}
  [[ $host == \[*\] ]] && return 0
  IFS=. read -r -a octet <<< "$host"
  for host in "${octet[@]}"; do
    [[ $host =~ ^(0|[1-9][0-9]{0,2})$ ]] && (( host <= 255 )) || return 1
  done
)

if [[ $command == version ]]; then
  exec /usr/local/bin/gofro-router-server --version
elif [[ $command == update ]]; then
  exec timeout 900 /usr/local/sbin/gofro-server-install >/dev/null
elif [[ $command =~ ^managed-status$ ]]; then
  exec timeout 30 /usr/local/bin/gofro-router-server managed-status
elif [[ $command =~ ^create-friend\ ((\[[0-9a-f:]+\]|[0-9]{1,3}(\.[0-9]{1,3}){3}):8443)$ ]]; then
  valid_endpoint "${BASH_REMATCH[1]}" || exit 126
  exec timeout 30 /usr/local/bin/gofro-router-server create-friend "${BASH_REMATCH[1]}"
elif [[ $command =~ ^rename-friend\ ([A-Za-z0-9+/]{43}=)$ ]]; then
  exec timeout 30 /usr/local/bin/gofro-router-server rename-friend "${BASH_REMATCH[1]}"
elif [[ $command =~ ^revoke-friend\ ([A-Za-z0-9+/]{43}=)$ ]]; then
  exec timeout 30 /usr/local/bin/gofro-router-server revoke-friend "${BASH_REMATCH[1]}"
elif [[ $command =~ ^friend-profile\ ([A-Za-z0-9+/]{43}=)\ ((\[[0-9a-f:]+\]|[0-9]{1,3}(\.[0-9]{1,3}){3}):8443)$ ]]; then
  valid_endpoint "${BASH_REMATCH[2]}" || exit 126
  exec timeout 30 /usr/local/bin/gofro-router-server friend-profile "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
elif [[ $command == restart-vpn ]]; then
  exec timeout 60 /usr/local/bin/gofro-router-server restart-vpn
elif [[ $command =~ ^create-router-profile\ ((\[[0-9a-f:]+\]|[0-9]{1,3}(\.[0-9]{1,3}){3}):8443)$ ]]; then
  valid_endpoint "${BASH_REMATCH[1]}" || exit 126
  exec timeout 30 /usr/local/bin/gofro-router-server create-profile \
    --endpoint "${BASH_REMATCH[1]}" --subnet 10.203.1.0/24
elif [[ $command =~ ^create-profile\ ((\[[0-9a-f:]+\]|[0-9]{1,3}(\.[0-9]{1,3}){3}):8443)$ ]]; then
  valid_endpoint "${BASH_REMATCH[1]}" || exit 126
  exec timeout 30 /usr/local/bin/gofro-router-server create-profile --endpoint "${BASH_REMATCH[1]}"
elif [[ $command =~ ^remove-router-peer\ ([A-Za-z0-9+/]{43}=)$ ]]; then
  exec timeout 30 /usr/local/bin/gofro-router-server remove-peer \
    --public-key "${BASH_REMATCH[1]}" --subnet 10.203.1.0/24
else
  exit 126
fi
